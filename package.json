{
  "name": "mobility-platform",
  "private": true,
  "description": "Plateforme de mobilité internationale (projet pédagogique : partenariats fictifs)",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.3"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "pnpm --filter @mobility/db run migrate",
    "db:generate": "pnpm --filter @mobility/db run generate",
    "db:seed": "pnpm --filter @mobility/db run seed",
    "data:students": "pnpm --filter @mobility/generator run generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "supabase": "3.4.0",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
